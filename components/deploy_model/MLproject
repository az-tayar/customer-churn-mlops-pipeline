name: deploy_model
conda_env: conda.yml

entry_points:
  main:
    parameters:
      host:
        description: The IP address for deploying the prod model
        type: str

      api_port:
        description: The port number for listening to the FastAPI server
        type: int

      export_model:
        description: Exported model artifact for deployment
        type: str

    command: python run.py --host {host} --api_port {api_port} --export_model {export_model}